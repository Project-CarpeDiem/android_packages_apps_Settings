<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- MaxxOS about header -->
    <color name="user_crd_bg">#FFFFFFFF</color>
    <color name="op_control_text_color_primary">#d8000000</color>
    <color name="op_control_text_color_secondary">#66000000</color>
    <color name="op_text_color_secondary">#66000000</color>
    <color name="device_info_version_bg">#000000</color>
    <color name="device_info_version_text">#d9d9d9</color>

    <dimen name="card_margin_start_aqua">20dp</dimen>
    <dimen name="card_margin_end_aqua">20dp</dimen>

    <string name="build_is_official_title">#Official</string>
    <string name="build_is_community_title">#Community</string>
    <string name="maintainer_summary">by %s</string>
    <string name="unknown_maintainer">unknown</string>
    <string name="device_info_battery">Battery</string>
    <string name="device_info_chipset">Chipset</string>
    <string name="device_info_resolution">Resolution</string>
    <string name="device_info_storage">Storage</string>

    <style name="op_control_text_style_base">
        <item name="android:breakStrategy">simple</item>
        <item name="android:textColorSecondary">@color/op_text_color_secondary</item>
    </style>

    <style name="op_control_text_style_body1" parent="@style/op_control_text_style_base">
        <item name="android:textSize">13.0sp</item>
        <item name="android:fontFamily">@*android:string/config_bodyFontFamily</item>
    </style>

    <style name="op_control_text_style_h6" parent="@style/op_control_text_style_base">
        <item name="android:textSize">18.0sp</item>
        <item name="android:fontFamily">@*android:string/config_headlineFontFamilyMedium</item>
        <item name="android:elevation">0dp</item>
    </style>
</resources>
